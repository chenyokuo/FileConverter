{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Converter",
  "version": "1.1.0-rc.1",
  "identifier": "studio.rai.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "File Converter",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/previews/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": {
      "notices/": "licenses/",
      "bundled-engines/": "engines/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE",
      "binaries/FileConverterEngine/": "binaries/FileConverterEngine/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "webview-runtime/Microsoft.WebView2.FixedVersionRuntime.157.0.4341.60.x64"
      },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "TradChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "File Converter",
        "installerHooks": "windows/hooks.nsh",
        "template": "windows/installer.nsi.hbs"
      }
    },
    "shortDescription": "Offline file conversion and processing",
    "category": "Utility"
  },
  "mainBinaryName": "FileConverter"
}
