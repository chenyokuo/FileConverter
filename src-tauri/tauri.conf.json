{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAI Converter",
  "version": "0.1.0",
  "identifier": "studio.rai.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RAI Converter",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "binaries/": "binaries/",
      "notices/": "licenses/",
      "../vendor/ffmpeg/": "engines/ffmpeg/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["TradChinese", "English"]
      }
    },
    "shortDescription": "Private files. Beautifully converted.",
    "category": "Utility"
  }
}
